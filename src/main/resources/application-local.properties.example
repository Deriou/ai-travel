# Copy this file to application-local.properties and fill in your own credentials.
# Never commit real passwords or API keys.
spring.datasource.url=jdbc:mysql://localhost:3306/ai_travel
spring.datasource.username=root
spring.datasource.password=CHANGE_ME

# JWT signing key: any random string with at least 32 characters.
jwt.secret=CHANGE_ME_TO_A_RANDOM_STRING_AT_LEAST_32_CHARS

# DeepSeek API Key from https://platform.deepseek.com/api_keys
ai.api-key=CHANGE_ME
